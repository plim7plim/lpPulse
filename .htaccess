Options -Indexes
DirectoryIndex index.html
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<FilesMatch "(^\.|\.(sql|ini|log|env|ps1|md)$|(?:config\.example|panel-config\.example)\.php$)">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:database|scripts|docs)(?:/|$) - [F,L]
  RewriteRule ^backend/(?!api\.php$|webhook\.php$) - [F,L]
</IfModule>
